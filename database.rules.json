{
  "rules": {
    "lobbies": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[A-HJ-NP-Z]{4}$/)",
        "createdAt": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber()"
        },
        "masterId": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && !root.child('lobbies').child($code).child('game').exists()",
          ".validate": "newData.val() === auth.uid"
        },
        "names": {
          "$key": {
            ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
            ".validate": "newData.val() === auth.uid"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || !newData.exists() || !root.child('lobbies').child($code).child('game').exists())",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && root.child('lobbies').child($code).child('createdAt').exists()",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "presence": {
          "$uid": {
            "$conn": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === true"
            }
          }
        },
        "game": {
          ".write": "auth != null && root.child('lobbies').child($code).child('masterId').val() === auth.uid",
          ".validate": "newData.hasChild('phase')",
          "phase": { ".validate": "newData.val() === 'setup' || newData.val() === 'assigned'" },
          "counts": { "$role": { ".validate": "newData.isNumber()" } },
          "startedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "secrets": {
      "$code": {
        ".read": "auth != null && root.child('lobbies').child($code).child('masterId').val() === auth.uid",
        ".write": "auth != null && root.child('lobbies').child($code).child('masterId').val() === auth.uid",
        "roles": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().matches(/^(citizen|wolf|magician|medium)$/)"
          }
        },
        "wolves": {
          ".read": "auth != null && root.child('secrets').child($code).child('roles').child(auth.uid).val() === 'wolf'",
          "$uid": { ".validate": "newData.val() === true" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
