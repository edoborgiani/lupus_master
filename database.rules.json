{
  "rules": {
    "lobbies": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[A-HJ-NP-Z]{4}$/)",
        "createdAt": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber()"
        },
        "hostId": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid || !root.child('lobbies').child($code).child('players').child(data.val()).exists())",
          ".validate": "newData.val() === auth.uid || root.child('lobbies').child($code).child('players').child(newData.val()).exists()"
        },
        "masterId": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && !root.child('lobbies').child($code).child('game').exists()",
          ".validate": "newData.val() === auth.uid"
        },
        "names": {
          "$key": {
            ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
            ".validate": "newData.val() === auth.uid"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || !newData.exists() || !root.child('lobbies').child($code).child('game').exists())",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && root.child('lobbies').child($code).child('createdAt').exists()",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "presence": {
          "$uid": {
            "$conn": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === true"
            }
          }
        },
        "settings": {
          ".write": "auth != null && (root.child('lobbies').child($code).child('masterId').val() === auth.uid || (!root.child('lobbies').child($code).child('masterId').exists() && root.child('lobbies').child($code).child('hostId').val() === auth.uid)) && !root.child('lobbies').child($code).child('game').exists()",
          "mode": {
            ".validate": "newData.val() === 'live' || newData.val() === 'hybrid' || newData.val() === 'remote'"
          },
          "rules": {
            "$rule": {
              ".validate": "newData.isBoolean() || newData.isString()"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "seen": {
          ".write": "auth != null && (root.child('lobbies').child($code).child('masterId').val() === auth.uid || (!root.child('lobbies').child($code).child('masterId').exists() && root.child('lobbies').child($code).child('hostId').val() === auth.uid))",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        },
        "game": {
          ".write": "auth != null && (root.child('lobbies').child($code).child('masterId').val() === auth.uid || (!root.child('lobbies').child($code).child('masterId').exists() && root.child('lobbies').child($code).child('hostId').val() === auth.uid))",
          ".validate": "newData.hasChild('phase')",
          "phase": {
            ".validate": "newData.val().matches(/^(setup|assigned|night|day|over)$/)"
          },
          "mode": {
            ".validate": "newData.val() === 'remote' || ((newData.val() === 'live' || newData.val() === 'hybrid') && root.child('lobbies').child($code).child('masterId').exists())"
          }
        },
        "nightDone": {
          ".write": "auth != null && (root.child('lobbies').child($code).child('masterId').val() === auth.uid || (!root.child('lobbies').child($code).child('masterId').exists() && root.child('lobbies').child($code).child('hostId').val() === auth.uid))",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('lobbies').child($code).child('game').child('mode').val() === 'remote' && root.child('lobbies').child($code).child('game').child('phase').val() === 'night' && root.child('lobbies').child($code).child('game').child('alive').child($uid).val() === true",
            ".validate": "newData.val() === true"
          }
        },
        "decree": {
          ".write": "auth != null && (root.child('lobbies').child($code).child('masterId').val() === auth.uid || (!root.child('lobbies').child($code).child('masterId').exists() && root.child('lobbies').child($code).child('hostId').val() === auth.uid))",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('secrets').child($code).child('roles').child($uid).val() === 'mayor' && (root.child('lobbies').child($code).child('game').child('mode').val() === 'remote' || (root.child('lobbies').child($code).child('game').child('mode').val() === 'hybrid' && root.child('lobbies').child($code).child('game').child('rules').child('hybridVote').val() === 'phones')) && root.child('lobbies').child($code).child('game').child('phase').val() === 'day' && root.child('lobbies').child($code).child('game').child('alive').child($uid).val() === true && root.child('lobbies').child($code).child('game').child('vote').child('done').val() !== true && (root.child('lobbies').child($code).child('game').child('rules').child('mayorUses').val() === 'every' || root.child('lobbies').child($code).child('game').child('mayorUsed').child($uid).val() !== true)",
            ".validate": "newData.isString() && newData.val() !== $uid && root.child('lobbies').child($code).child('game').child('alive').child(newData.val()).val() === true && (!root.child('lobbies').child($code).child('game').child('vote').child('candidates').exists() || root.child('lobbies').child($code).child('game').child('vote').child('candidates').child(newData.val()).exists())"
          }
        },
        "votes": {
          ".write": "auth != null && (root.child('lobbies').child($code).child('masterId').val() === auth.uid || (!root.child('lobbies').child($code).child('masterId').exists() && root.child('lobbies').child($code).child('hostId').val() === auth.uid))",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('lobbies').child($code).child('game').child('mode').val() === 'remote' || (root.child('lobbies').child($code).child('game').child('mode').val() === 'hybrid' && root.child('lobbies').child($code).child('game').child('rules').child('hybridVote').val() === 'phones')) && root.child('lobbies').child($code).child('game').child('phase').val() === 'day' && root.child('lobbies').child($code).child('game').child('alive').child($uid).val() === true && root.child('lobbies').child($code).child('game').child('vote').child('done').val() !== true",
            ".validate": "newData.isString() && (newData.val() !== $uid || root.child('lobbies').child($code).child('game').child('rules').child('selfVote').val() === true) && root.child('lobbies').child($code).child('game').child('alive').child(newData.val()).val() === true && (!root.child('lobbies').child($code).child('game').child('vote').child('candidates').exists() || root.child('lobbies').child($code).child('game').child('vote').child('candidates').child(newData.val()).exists())"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "secrets": {
      "$code": {
        ".read": "auth != null && (root.child('lobbies').child($code).child('masterId').val() === auth.uid || (!root.child('lobbies').child($code).child('masterId').exists() && root.child('lobbies').child($code).child('hostId').val() === auth.uid))",
        ".write": "auth != null && (root.child('lobbies').child($code).child('masterId').val() === auth.uid || (!root.child('lobbies').child($code).child('masterId').exists() && root.child('lobbies').child($code).child('hostId').val() === auth.uid))",
        "roles": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().matches(/^(citizen|wolf|damned|seer|magician|medium|gravedigger|mime|mason|prole|mayor)$/)"
          }
        },
        "wolves": {
          ".read": "auth != null && (root.child('secrets').child($code).child('roles').child(auth.uid).val() === 'wolf' || root.child('secrets').child($code).child('roles').child(auth.uid).val() === 'damned')",
          "$uid": {
            ".validate": "newData.val() === true"
          }
        },
        "masons": {
          ".read": "auth != null && root.child('secrets').child($code).child('roles').child(auth.uid).val() === 'mason'",
          "$uid": {
            ".validate": "newData.val() === true"
          }
        },
        "cursed": {
          "$uid": {
            ".validate": "newData.val() === true"
          }
        },
        "converted": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber()"
          }
        },
        "wolfVotes": {
          ".read": "auth != null && root.child('secrets').child($code).child('roles').child(auth.uid).val() === 'wolf'",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('lobbies').child($code).child('game').child('mode').val() === 'remote' || (root.child('lobbies').child($code).child('game').child('mode').val() === 'hybrid' && root.child('lobbies').child($code).child('game').child('step').val() === 'wolves')) && root.child('lobbies').child($code).child('game').child('phase').val() === 'night' && root.child('lobbies').child($code).child('game').child('alive').child($uid).val() === true && root.child('secrets').child($code).child('roles').child($uid).val() === 'wolf'",
            ".validate": "newData.isString() && root.child('lobbies').child($code).child('game').child('alive').child(newData.val()).val() === true && root.child('secrets').child($code).child('roles').child(newData.val()).val() !== 'wolf'"
          }
        },
        "actions": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && (root.child('lobbies').child($code).child('game').child('mode').val() === 'remote' || (root.child('lobbies').child($code).child('game').child('mode').val() === 'hybrid' && root.child('lobbies').child($code).child('game').child('step').val() === root.child('secrets').child($code).child('roles').child($uid).val())) && root.child('lobbies').child($code).child('game').child('phase').val() === 'night' && root.child('lobbies').child($code).child('game').child('alive').child($uid).val() === true && (root.child('secrets').child($code).child('roles').child($uid).val() === 'magician' || root.child('secrets').child($code).child('roles').child($uid).val() === 'medium' || (root.child('secrets').child($code).child('roles').child($uid).val() === 'seer' && !data.exists() && (root.child('lobbies').child($code).child('game').child('rules').child('seerUses').val() !== 'once' || !root.child('secrets').child($code).child('memo').child($uid).child('used').exists())) || (root.child('secrets').child($code).child('roles').child($uid).val() === 'gravedigger' && !data.exists() && (root.child('lobbies').child($code).child('game').child('rules').child('gravediggerUses').val() !== 'once' || !root.child('secrets').child($code).child('graves').child($uid).exists())) || (root.child('secrets').child($code).child('roles').child($uid).val() === 'mime' && !data.exists() && root.child('lobbies').child($code).child('game').child('round').val() === 1))",
            ".validate": "newData.isString() && ((newData.val() === 'skip' && (root.child('secrets').child($code).child('roles').child($uid).val() === 'seer' || root.child('secrets').child($code).child('roles').child($uid).val() === 'gravedigger')) || (newData.val() === 'dig' && root.child('secrets').child($code).child('roles').child($uid).val() === 'gravedigger') || (root.child('secrets').child($code).child('roles').child($uid).val() !== 'gravedigger' && (newData.val() !== $uid || (root.child('secrets').child($code).child('roles').child($uid).val() === 'magician' && root.child('lobbies').child($code).child('game').child('rules').child('magicianSelf').val() === true)) && root.child('lobbies').child($code).child('game').child('alive').child(newData.val()).val() === true))"
          }
        },
        "suspects": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$round": {
              ".write": "auth != null && auth.uid === $uid && root.child('lobbies').child($code).child('game').child('mode').val() === 'remote' && root.child('lobbies').child($code).child('game').child('phase').val() === 'night' && root.child('lobbies').child($code).child('game').child('round').val() + '' === $round && root.child('lobbies').child($code).child('game').child('alive').child($uid).val() === true",
              ".validate": "newData.isString() && newData.val() !== $uid && root.child('lobbies').child($code).child('game').child('alive').child(newData.val()).val() === true"
            }
          }
        },
        "visions": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$round": {
              ".validate": "newData.hasChildren(['target', 'wolf'])"
            }
          }
        },
        "memo": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "graves": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$round": {
              ".validate": "newData.hasChildren(['target', 'wolf'])"
            }
          }
        },
        "mimed": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString()"
          }
        },
        "nightLog": {
          "$round": {
            ".validate": "newData.hasChild('reason')"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
